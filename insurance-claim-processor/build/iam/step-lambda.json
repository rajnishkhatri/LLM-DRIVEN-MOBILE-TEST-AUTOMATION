{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeTwoArn",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-*",
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-*"
      ]
    },
    {
      "Sid": "ApplyGuardrail",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:*:*:guardrail/claim-processor*"
    },
    {
      "Sid": "ReadClaims",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::claim-documents-poc-*/claims/*"
    },
    {
      "Sid": "WriteResultsAndPending",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::claim-documents-poc-*/results/*",
        "arn:aws:s3:::claim-documents-poc-*/pending-review/*"
      ]
    },
    {
      "Sid": "KmsViaService",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:*:*:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "s3.us-east-1.amazonaws.com",
            "bedrock.us-east-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "KbRetrieveFastFollow",
      "Effect": "Allow",
      "Action": "bedrock:Retrieve",
      "Resource": "arn:aws:bedrock:*:*:knowledge-base/*"
    }
  ]
}
