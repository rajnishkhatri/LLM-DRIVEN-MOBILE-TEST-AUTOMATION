# Clean Architecture — concentric rings (after Fig 22.1).
# Real container nesting: each ring physically contains the next.

title: "Clean Architecture — the concentric circles" {
  shape: text
  near: top-center
  style: {
    font-size: 24
    bold: true
  }
}

frameworks: "Frameworks & Drivers" {
  style: {
    fill: "#9e9e9e"
    stroke: "#4a4a4a"
    border-radius: 80
    font-size: 20
    bold: true
  }

  frameworks_role: "Web, DB, Devices, UI" {
    shape: text
    style: {
      font-size: 15
      italic: true
    }
  }

  adapters: "Interface Adapters" {
    style: {
      fill: "#bdbdbd"
      stroke: "#4a4a4a"
      border-radius: 70
      font-size: 19
      bold: true
    }

    adapters_role: "Controllers, Presenters, Gateways" {
      shape: text
      style: {
        font-size: 15
        italic: true
      }
    }

    usecases: "Use Cases" {
      style: {
        fill: "#dcdcdc"
        stroke: "#4a4a4a"
        border-radius: 60
        font-size: 18
        bold: true
      }

      usecases_role: "Application Business Rules" {
        shape: text
        style: {
          font-size: 15
          italic: true
        }
      }

      entities: "Entities" {
        style: {
          fill: "#f5f5f5"
          stroke: "#4a4a4a"
          border-radius: 50
          font-size: 17
          bold: true
        }

        entities_role: "Enterprise Business Rules" {
          shape: text
          style: {
            font-size: 14
            italic: true
          }
        }
      }
    }
  }
}

caption: "The Dependency Rule:\nsource code dependencies must point only inward,\ntoward higher-level policies." {
  shape: rectangle
  near: bottom-center
  style: {
    fill: "#ffffff"
    stroke: "#4a4a4a"
    stroke-dash: 4
    font-size: 16
  }
}
