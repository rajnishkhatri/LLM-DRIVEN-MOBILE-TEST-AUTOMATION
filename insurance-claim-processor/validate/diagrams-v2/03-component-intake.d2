RCAT -> GBQ: "2"
GBQ -> GDQ: "3" { style.stroke-dash: 3 }
GBQ -> GCR: "4"
RCAT -> GCR: "5"
GCR -> CAN: "6"
GCR -> ANQ: "7"
GCR -> RDT: "8"
GCR -> TRC: "9"
GCR -> SLH: "10"
