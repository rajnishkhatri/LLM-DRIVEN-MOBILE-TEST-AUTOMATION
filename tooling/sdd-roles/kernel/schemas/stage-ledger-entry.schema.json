{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-roles:stage-ledger-entry:1.4.0",
  "title": "StageLedgerEntry",
  "oneOf": [
    { "$ref": "#/$defs/genesis_entry" },
    { "$ref": "#/$defs/regular_entry" }
  ],
  "$defs": {
    "genesis_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "run_id",
        "seq",
        "prev_entry_digest",
        "tree_digest",
        "writer",
        "ts"
      ],
      "properties": {
        "schema_version": { "const": "1.4.0" },
        "artifact_type": { "const": "stage_ledger_entry" },
        "run_id": { "type": "string", "minLength": 1 },
        "seq": { "const": 0 },
        "prev_entry_digest": { "type": "null" },
        "kernel_config_digest": { "type": "string", "minLength": 1 },
        "role_registry_digest": { "type": "string", "minLength": 1 },
        "tree_digest": { "type": "string", "minLength": 1 },
        "parent_run": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "final_entry_digest"],
              "properties": {
                "run_id": { "type": "string", "minLength": 1 },
                "final_entry_digest": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "writer": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "minLength": 1 }
      }
    },
    "regular_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "run_id",
        "seq",
        "prev_entry_digest",
        "stage",
        "role",
        "event",
        "gates",
        "writes",
        "tree_digest",
        "artifacts",
        "harness",
        "writer",
        "ts"
      ],
      "properties": {
        "schema_version": { "const": "1.4.0" },
        "artifact_type": { "const": "stage_ledger_entry" },
        "run_id": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 1 },
        "prev_entry_digest": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "event": { "enum": ["entered", "gate_run", "passed", "failed", "rework", "handoff"] },
        "gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_stage", "target_role", "count", "max"],
          "properties": {
            "from_stage": { "type": "string", "minLength": 1 },
            "target_role": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "change", "sha256_before", "sha256_after"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "change": { "enum": ["added", "modified", "deleted"] },
              "sha256_before": { "type": ["string", "null"] },
              "sha256_after": { "type": ["string", "null"] }
            }
          }
        },
        "tree_digest": { "type": "string", "minLength": 1 },
        "input_tree_digest": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "minLength": 1 }
            }
          }
        },
        "handoff_contract_digest": { "type": ["string", "null"] },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "resume_handle", "agent_definition_digest"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "resume_handle": { "type": "string", "minLength": 1 },
            "agent_definition_digest": { "type": "string", "minLength": 1 }
          }
        },
        "writer": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "minLength": 1 }
      }
    }
  }
}
