{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-roles:role-registry:1.4.0",
  "title": "RoleRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "roles", "arms"],
  "properties": {
    "schema_version": { "const": "1.4.0" },
    "artifact_type": { "const": "role_registry" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "arms": {
      "type": "array",
      "items": { "$ref": "#/$defs/arm" }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "gates", "write_scopes", "diagnostic_capability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tag": { "enum": ["maker", "checker"] },
        "gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "write_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "diagnostic_capability": { "type": "boolean" },
        "invocation": { "$ref": "#/$defs/invocation" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "agents_file": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "ablation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
