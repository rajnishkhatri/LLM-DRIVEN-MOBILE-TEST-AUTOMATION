    {
      "harness": "copilot",
      "command_template": "copilot -p {prompt} --agent {agent}",
      "agent_selection": "dual-target-agents",
      "auth_env_var": "GH_TOKEN",
      "resume_semantics": "per-pr-memory",
      "output_parse_mode": "text",
      "exit_code_map": [
        {
          "tool_exit": 0,
          "decision_output": "allow",
          "wrapper_exit": 0
        },
        {
          "tool_exit": 1,
          "decision_output": "deny",
          "wrapper_exit": 1
        },
        {
          "tool_exit": 2,
          "decision_output": "deny",
          "wrapper_exit": 1
        },
        {
          "tool_exit": 3,
          "decision_output": "deny",
          "wrapper_exit": 1
        }
      ]
    }
  ]
