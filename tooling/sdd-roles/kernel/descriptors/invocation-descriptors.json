          },
          {
            "args_token": "$ARGUMENTS",
            "char_cap": null,
            "format": "markdown",
            "front_matter": [
              {
                "key": "name",
                "source": "id"
              },
              {
                "key": "description",
                "source": "description"
              },
              {
                "key": "stamp",
                "source": "stamp"
              }
            ],
            "kind": "agent-card",
            "path_template": "agents/{role}.md"
          },
          {
            "args_token": null,
            "char_cap": null,
            "format": "markdown",
            "front_matter": [
              {
                "key": "name",
                "source": "id"
              },
              {
                "key": "description",
                "source": "description"
              },
              {
                "key": "stamp",
                "source": "stamp"
              }
            ],
            "kind": "kernel-skill",
            "path_template": "skills/sdd-roles/SKILL.md"
          },
          {
            "args_token": null,
            "char_cap": null,
            "format": "json",
            "kind": "mount-copy",
            "path_template": "hooks/hooks.json"
          }
        ]
      },
      "resume_semantics": "resume-handle"
    },
