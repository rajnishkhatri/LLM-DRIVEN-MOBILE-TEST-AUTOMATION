{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadClaimResults",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::claim-documents-poc-rk-20260922/results/claims/*"
    },
    {
      "Sid": "ListClaimResultsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::claim-documents-poc-rk-20260922",
      "Condition": {"StringLike": {"s3:prefix": "results/claims/*"}}
    }
  ]
}
