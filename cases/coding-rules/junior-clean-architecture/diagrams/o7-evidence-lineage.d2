# Evidence and lineage — the record-keeping spine.
# One primary store partitioned by lifecycle; object storage behind a port;
# the execution plan is a projection rendered FROM the digest, never a second source of truth.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  policy: {
    style: {
      fill: "#DCECE9"
      stroke: "#1F6F6B"
      font-color: "#134844"
      border-radius: 6
      stroke-width: 2
    }
  }
  detail: {
    style: {
      fill: "#F1E3CE"
      stroke: "#B0742A"
      font-color: "#6E4718"
      border-radius: 6
      stroke-width: 2
    }
  }
  port: {
    style: {
      fill: "#E7E1F1"
      stroke: "#6A5A9C"
      font-color: "#453A6B"
      border-radius: 6
      stroke-width: 2
      stroke-dash: 4
    }
  }
  human: {
    style: {
      fill: "#E3E9F2"
      stroke: "#495C77"
      font-color: "#2F3E52"
      border-radius: 6
      stroke-width: 2
    }
  }
  flow: {
    style: {
      stroke: "#4A5A59"
      font-color: "#4A5A59"
      font-size: 13
    }
  }
}

run: "Interpreter run\n(per-step evidence,\nhash-at-pull on every\ndevice artifact)" { class: policy }

store: "ONE PRIMARY STORE — partitioned by lifecycle" {
  style: {
    fill: "#F2F7F6"
    stroke: "#1F6F6B"
    stroke-width: 2
    border-radius: 8
    font-color: "#134844"
    font-size: 15
    bold: true
  }
  lineage: "append-only lineage\nper-conversion hash chain\nevery row carries a principal" { class: policy }
  outbox: "transactional outbox\nlineage + message,\nsame transaction" { class: policy }
}

s3port: "«S3 port»\nevidence store\ninterface" { class: port }
s3impl: "object storage\n(today: S3-compatible)" { class: detail }

bundle: "A-STD evidence bundle" {
  style: {
    fill: "#F6F8F7"
    stroke: "#5B8A85"
    stroke-width: 2
    border-radius: 8
    font-color: "#134844"
    font-size: 15
    bold: true
  }
  rr: "ReplayReport\nirDigest + interpreterVersion\n+ captured Perfecto versions\n+ cloudAdaptivityDisabled" { class: policy }
  plan: "execution plan\nrendered FROM irDigest\nat replay time —\nevidence, never a pin" { class: policy }
}

auditor: "The auditor\nreads the plan,\nverifies the chain,\nre-runs the SHAs" { class: human }

run -> store.lineage: "same-transaction\nwrites" { class: flow }
store.lineage -> store.outbox: { class: flow }
run -> bundle.rr: { class: flow }
bundle.rr -> bundle.plan: "deterministic\nprojection" { class: flow }
bundle.rr -> s3port: "stores through\nthe port" { class: flow }
s3impl -> s3port: "implements" {
  style: {
    stroke: "#B0742A"
    stroke-dash: 4
    font-color: "#6E4718"
    font-size: 13
  }
  target-arrowhead: {
    shape: triangle
    style.filled: false
  }
}
bundle.plan -> auditor: "reads English,\nnot code" { class: flow }
