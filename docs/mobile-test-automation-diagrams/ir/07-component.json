  "view": {
    "id": "07-component",
    "level": "component",
    "title": "C3a \u2014 Component view: module flow",
    "caption": "How does a conversion move through the 16 components? This view opens the APP container from C2a (whose module-grain wiring is C2b) \u2014 all sixteen components in their three modules. Flow only \u2014 screening edges are C3b, provenance edges are C3c. Canvas carries numbered edge refs; the full claim lives in the edge-detail table keyed by number.",
    "direction": "down",
    "opens": "APP",
    "opens_from": "02-container",
    "completeness": "complete",
    "overlays": "auto"
  },
  "nodes": [
    {
      "id": "QA",
      "kind": "actor",
      "label": "QA engineer",
      "detail": [
        "IDE + 2 CLIs. In P1 the conversion reasoning happens in THIS actor's IDE (Copilot, ADR 0001); the system receives only committed artifacts"
      ]
    },
    {
      "id": "REVIEWER",
      "kind": "actor",
      "label": "Reviewer",
      "detail": [
        "HITL queue; responds in hours\u2013days"
      ]
    },
    {
      "id": "AUDITOR",
      "kind": "actor",
      "label": "Auditor",
      "detail": [
        "Must reconstruct verdicts from stored evidence alone, without access to the running system (ADR 0008)"
      ]
    },
    {
      "id": "LEAD",
      "kind": "actor",
      "label": "Delivery lead",
      "detail": [
        "Read-only metrics"
      ]
    },
    {
      "id": "COORDINATE_CONVERSION",
      "kind": "component",
      "family": "module-a",
      "label": "Coordinate Conversion",
      "detail": [
        "State machine + retry budgets; CE=11, CA=0 (ADR 0003). Repair budgets: 3 static, 3 device"
      ]
    },
    {
      "id": "INGEST_TEST_SOURCES",
      "kind": "component",
      "family": "module-a",
      "label": "Ingest Test Sources",
      "detail": [
        "Adapters: Excel + Octane now, ALM/QC later (C1). Hash-at-ingest snapshot digest (M15)"
      ]
    },
    {
      "id": "INTERPRET_TEST_INTENT",
      "kind": "component",
      "family": "module-a",
      "label": "Interpret Test Intent",
      "detail": [
        "Emits TestCaseIR; flags ambiguity"
      ]
    },
    {
      "id": "ACQUIRE_UI_EVIDENCE",
      "kind": "component",
      "family": "module-a",
      "label": "Acquire UI Evidence",
      "detail": [
        "Hierarchy tool: page source, Object Spy, pruned tree. Records device + pool identity; off-pool captures flagged (M24)"
      ]
    },
    {
      "id": "RESOLVE_ELEMENTS",
      "kind": "component",
      "family": "module-a",
      "label": "Resolve Elements",
      "detail": [
        "Owns the locator cascade. Octane locator lookup STUBBED IN SPINE (C5)"
      ]
    },
    {
      "id": "RETRIEVE_CONVERSION_ASSETS",
      "kind": "component",
      "family": "module-a",
      "label": "Retrieve Conversion Assets",
      "detail": [
        "Versioned prompts, house rules, exemplars"
      ]
    },
    {
      "id": "GENERATE_TEST_CODE",
      "kind": "component",
      "family": "module-a",
      "label": "Generate Test Code",
      "detail": [
        "Page Objects + Appium Java/TestNG"
      ]
    },
    {
      "id": "REPAIR_LOCATORS",
      "kind": "component",
      "family": "module-a",
      "label": "Repair Locators",
      "detail": [
        "Bounded re-grounding"
      ]
    },
    {
      "id": "INVOKE_MODELS",
      "kind": "component",
      "family": "module-a",
      "label": "Invoke Models",
      "role": "model-seam",
      "detail": [
        "THE model seam (ADR 0001): P1 Copilot impl / P2 gateway impl, config-selected. Cache key incl. model+provider version (ADR 0002). P2 edge tags = runtime call exists in Phase 2 only; the seam and its callers exist from the first commit (F1)"
      ]
    },
    {
      "id": "ROUTE_HUMAN_DECISIONS",
      "kind": "component",
      "family": "module-a",
      "label": "Route Human Decisions",
      "detail": [
        "Authenticated; every decision attributed to an individual principal (M37)"
      ]
    },
    {
      "id": "VERIFY_STATICALLY",
      "kind": "component",
      "family": "module-b",
      "label": "Verify Statically",
      "detail": [
        "Free, fast, deterministic. Capability rules gate generated code (ADR 0013)"
      ]
    },
    {
      "id": "REPLAY_ON_DEVICES",
      "kind": "component",
      "family": "module-b",
      "label": "Replay on Devices",
      "detail": [
        "K runs, pinned pools; dominant cost. Spawns the separate execution process, single-run token, NO gateway credential (ADR 0013). Records ACTUAL context beside requested; pinned-facet mismatch quarantines (M24)"
      ]
    },
    {
      "id": "CLASSIFY_REPLAY_OUTCOME",
      "kind": "component",
      "family": "module-b",
      "label": "Classify Replay Outcome",
      "detail": [
        "Rule-based taxonomy; unmapped outcome quarantines, never defaults (M10a)"
      ]
    },
    {
      "id": "CERTIFY_CONVERSION",
      "kind": "component",
      "family": "module-b",
      "label": "Certify Conversion",
      "detail": [
        "Grades fidelity + applies gates conjunctively; grade is ADVISORY to a human certifier (CF9). Custody-before-certify: every reference must resolve locally first (CF1)"
      ]
    },
    {
      "id": "PUBLISH_CERTIFIED_ASSETS",
      "kind": "component",
      "family": "module-b",
      "label": "Publish Certified Assets",
      "detail": [
        "Single-writer; certify-locally, publish-async (CF3)"
      ]
    },
    {
      "id": "PRESERVE_PROVENANCE",
      "kind": "component",
      "family": "module-c",
      "label": "Preserve Provenance",
      "role": "lineage-store",
      "detail": [
        "Append-only hash-chained lineage, CA=13 (ADR 0012); + metrics read model + auditor export (ADR 0008, CF11)"
      ]
    },
    {
      "id": "PERFECTO",
      "kind": "external",
      "family": "faded",
      "label": "Perfecto device lab",
      "detail": [
        "Drawn faded for location only; detail lives in the C2 tables"
