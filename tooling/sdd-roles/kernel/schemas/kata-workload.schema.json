{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-roles:kata-workload:1.4.0",
  "title": "KataWorkload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "instances"],
  "properties": {
    "schema_version": { "const": "1.4.0" },
    "artifact_type": { "const": "kata_workload" },
    "provenance_note": { "type": "string" },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "source_kata", "protected_tests"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": {
          "enum": ["greenfield-tdd", "legacy-refactor", "seeded-bugfix"]
        },
        "source_kata": { "type": "string", "minLength": 1 },
        "protected_tests": { "type": "boolean" }
      }
    }
  }
}
