RDT -> RSD: "12"
RSD -> CMP: "13"
RSD -> ELI: "14"
ELI -> CMP: "15"
RDT -> TXT: "16"
TRC -> TRS: "17" { style.stroke-dash: 3 }
ELI -> RCF: "18"
RDT -> RCF: "19"
SLH -> RCF: "20"
GCR -> RCF: "21"
RCF -> FMC: "22"
TRC -> FMC: "23"
FMC -> ASM: "24"
