        "mount_path": ".claude/settings.json",
        "command_template": "gate-wrap --descriptors {descriptors} --harness claude-code -- write-guard decide --kernel {kernel} --descriptors {descriptors} --harness claude-code --config {config} --registry {registry} --workspace {workspace} --run-dir {run_dir} --role {role}",
        "request": {
          "paths_pointers": [
            "/tool_input/file_path",
            "/tool_input/notebook_path"
          ],
          "operation": {
            "pointer": "/tool_name",
            "map": [
              {
                "from": "Write",
                "to": "create"
              },
              {
                "from": "Edit",
                "to": "modify"
              },
              {
                "from": "MultiEdit",
                "to": "modify"
              },
              {
                "from": "NotebookEdit",
                "to": "modify"
              }
            ],
            "default": "modify"
          }
        }
      },
      "projection": {
        "targets": [
          {
            "kind": "manifest",
            "path_template": ".claude-plugin/plugin.json",
            "format": "json",
            "char_cap": null,
            "args_token": null
          },
          {
            "kind": "agent-card",
            "path_template": "agents/{role}.md",
            "format": "markdown",
            "front_matter": [
              {
                "key": "name",
                "source": "id"
              },
              {
                "key": "description",
                "source": "description"
              },
              {
                "key": "stamp",
                "source": "stamp"
              }
            ],
            "char_cap": null,
            "args_token": "$ARGUMENTS"
          },
          {
            "kind": "kernel-skill",
            "path_template": "skills/sdd-roles/SKILL.md",
            "format": "markdown",
            "front_matter": [
              {
                "key": "name",
                "source": "id"
              },
              {
                "key": "description",
                "source": "description"
              },
              {
                "key": "stamp",
                "source": "stamp"
              }
            ],
            "char_cap": null,
            "args_token": null
          },
          {
            "kind": "mount-copy",
            "path_template": "hooks/hooks.json",
            "format": "json",
            "char_cap": null,
            "args_token": null
          }
        ]
      },
      "exit_code_map": [
        {
          "tool_exit": 0,
          "decision_output": "allow",
          "wrapper_exit": 0
        },
        {
          "tool_exit": 1,
          "decision_output": "error",
          "wrapper_exit": 1
        },
        {
          "tool_exit": 2,
          "decision_output": "block",
          "wrapper_exit": 2
        },
        {
          "tool_exit": 3,
          "decision_output": "block",
          "wrapper_exit": 2
        }
      ]
    },
    {
      "harness": "cursor",
      "command_template": "agent -p {prompt} --model {model}",
      "agent_selection": "rules-dir",
      "auth_env_var": "CURSOR_API_KEY",
      "resume_semantics": "chat-restore-only",
      "output_parse_mode": "text",
      "exit_code_map": [
        {
          "tool_exit": 0,
          "decision_output": "allow",
          "wrapper_exit": 0
        },
        {
          "tool_exit": 1,
          "decision_output": "error",
          "wrapper_exit": 1
        },
        {
          "tool_exit": 2,
          "decision_output": "block",
          "wrapper_exit": 2
        },
        {
          "tool_exit": 3,
          "decision_output": "block",
          "wrapper_exit": 2
        }
