  "rows": [
    {
      "agent_selection": "agents-dir",
      "auth_env_var": "ANTHROPIC_API_KEY",
      "command_template": "claude -p \"{prompt} {args}\n\nRunner contract (mechanical): your stage is {role}. The run directory is {run_dir}. Before you finish, write a file named handoff.draft directly inside that run directory: one JSON object with exactly these top-level fields \u2014 schema_version 1.4.0 (a string), artifact_type handoff_contract, from_role {role}, to_role {next_role}, stage {role}, stage_status complete (or rework, plus a rework object whose target_role names the stage to send back to), summary (an object: text, plus a provenance object with source role_authored), decisions (at least ONE decision object is required on a completed stage handoff \u2014 for a pure verification stage your accept-or-reject verdict is that decision; each object needs choice, rationale, provenance with source role_authored, and EITHER a non-empty rejected_alternatives array whose every item is a plain non-empty STRING (one sentence of prose per rejected option \u2014 never an object, never a nested field) OR alternatives_considered set to the string none plus a non-empty alternatives_rationale; raw verification observations belong in the summary text, not as extra decisions), gate_outcomes (an empty array; the runner fills it), completion_evidence (an empty array). No other fields. All your other writes must stay inside your role write scopes.\" --agents {agents_file}",
      "exit_code_map": [
        {
          "decision_output": "allow",
          "tool_exit": 0,
          "wrapper_exit": 0
        },
        {
          "decision_output": "error",
          "tool_exit": 1,
          "wrapper_exit": 1
        },
        {
          "decision_output": "block",
          "tool_exit": 2,
          "wrapper_exit": 2
        },
        {
          "decision_output": "block",
          "tool_exit": 3,
          "wrapper_exit": 2
        }
      ],
      "harness": "claude-code",
      "hooks": {
        "command_template": "gate-wrap --descriptors {descriptors} --harness claude-code -- write-guard decide --kernel {kernel} --descriptors {descriptors} --harness claude-code --config {config} --registry {registry} --workspace {workspace} --run-dir {run_dir} --role {role}",
        "events": [
          "PreToolUse"
        ],
        "mount_path": ".claude/settings.json",
        "request": {
          "operation": {
            "default": "modify",
            "map": [
              {
                "from": "Write",
                "to": "create"
              },
              {
                "from": "Edit",
                "to": "modify"
              },
              {
                "from": "MultiEdit",
                "to": "modify"
              },
              {
                "from": "NotebookEdit",
                "to": "modify"
              }
            ],
            "pointer": "/tool_name"
          },
          "paths_pointers": [
