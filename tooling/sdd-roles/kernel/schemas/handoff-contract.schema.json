{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-roles:handoff-contract:1.4.0",
  "title": "HandoffContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "from_role",
    "to_role",
    "stage",
    "stage_status",
    "summary",
    "decisions",
    "gate_outcomes",
    "completion_evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.4.0" },
    "artifact_type": { "const": "handoff_contract" },
    "from_role": { "type": "string", "minLength": 1 },
    "to_role": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "stage_status": { "enum": ["complete", "rework", "in_progress"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "gate_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate_outcome" }
    },
    "completion_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_ref" }
    },
    "rework": { "$ref": "#/$defs/rework_edge" },
    "debug_report_ref": { "$ref": "#/$defs/artifact_ref" },
    "fences": {
      "type": "array",
      "items": { "$ref": "#/$defs/fence" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["role_authored", "tool_output", "environment_quoted"] },
        "derived_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fence_id": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "invocation_digest": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "environment_quoted" } } },
          "then": { "required": ["fence_id"] }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "rationale"],
      "properties": {
        "choice": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "rejected_alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alternatives_considered": { "const": "none" },
        "alternatives_rationale": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "oneOf": [
        {
          "required": ["rejected_alternatives"],
          "properties": { "rejected_alternatives": { "minItems": 1 } },
          "not": { "required": ["alternatives_considered"] }
        },
        {
          "required": ["alternatives_considered", "alternatives_rationale"],
          "not": { "required": ["rejected_alternatives"] }
        }
      ]
    },
    "gate_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "tool",
        "tool_version",
        "exit_code",
        "input_tree_digest",
        "attempt_number",
        "report_ref"
      ],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "input_tree_digest": { "type": "string", "minLength": 1 },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "value": { "type": "number" }
          }
        },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "report_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 }
      }
    },
    "rework_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_role", "counter"],
      "properties": {
        "target_role": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "defect_shape": { "type": "string", "minLength": 1 },
        "surviving_mutants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "counter": { "type": "integer", "minimum": 0 }
      }
    },
    "fence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fence_id", "content"],
      "properties": {
        "fence_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "source_uri": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
