# Ingestion — two vendor formats, one adapter contract, one canonical output.
# Substitutability at the door: the pipeline cannot tell which source fed it.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  policy: {
    style: {
      fill: "#DCECE9"
      stroke: "#1F6F6B"
      font-color: "#134844"
      border-radius: 6
      stroke-width: 2
    }
  }
  detail: {
    style: {
      fill: "#F1E3CE"
      stroke: "#B0742A"
      font-color: "#6E4718"
      border-radius: 6
      stroke-width: 2
    }
  }
  port: {
    style: {
      fill: "#E7E1F1"
      stroke: "#6A5A9C"
      font-color: "#453A6B"
      border-radius: 6
      stroke-width: 2
      stroke-dash: 4
    }
  }
  flow: {
    style: {
      stroke: "#4A5A59"
      font-color: "#4A5A59"
      font-size: 13
    }
  }
  impl: {
    style: {
      stroke: "#B0742A"
      stroke-dash: 4
      font-color: "#6E4718"
      font-size: 13
    }
  }
}

sources: "Vendor formats — volatile, not ours" {
  style: {
    fill: "#FBF7EF"
    stroke: "#B0742A"
    stroke-dash: 5
    border-radius: 8
    font-color: "#6E4718"
    font-size: 15
    bold: true
  }
  excel: "Excel workbooks\n(Apache POI)" { class: detail }
  octane: "Octane\n(REST API)" { class: detail }
}

contract: "«adapter contract»\none interface,\nboth sources satisfy it\nidentically" { class: port }

inside: "Inside the boundary — the pipeline's own shapes" {
  style: {
    fill: "#F2F7F6"
    stroke: "#1F6F6B"
    stroke-width: 2
    border-radius: 8
    font-color: "#134844"
    font-size: 15
    bold: true
  }
  canon: "per-adapter\ncanonicalization\n+ committed synonym table\n({sign in, log in, login} → login)" { class: policy }
  screen: "screening library\n(injection + secret/PII)\nversion pinned on the\nlineage row" { class: policy }
  digest: "source-snapshot\ndigest recorded\n(what we read,\nprovably)" { class: policy }
}

out: "Canonical intake\n— the ONLY thing\nthat leaves ingestion\n(F2, CI-enforced)" { class: policy }

sources.excel -> contract: "implements" { class: impl }
sources.octane -> contract: "implements" { class: impl }
contract -> inside.canon: { class: flow }
inside.canon -> inside.screen: { class: flow }
inside.screen -> inside.digest: { class: flow }
inside.digest -> out: { class: flow }

note: "No vendor type crosses out of its adapter.\nA quirky source is absorbed in ITS adapter —\nnever with if-statements inside the pipeline." {
  shape: rectangle
  near: bottom-center
  style: {
    fill: "#FFFFFF"
    stroke: "#8FA6A2"
    stroke-dash: 4
    font-color: "#4A5A59"
    font-size: 13
  }
}
