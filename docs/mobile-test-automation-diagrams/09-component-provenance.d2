# C3c — Component overlay: provenance & pinning
# caption: Who writes lineage, carrying what? A subset of C3a — the thirteen lineage writers, Preserve Provenance, and the two store edges. The thirteen edges are directed and unlabeled; they share the one meaning fixed in the key (§0).
direction: down

# Canonical reserved-vocabulary D2 classes for C4-flavored diagrams.
#
# The IR -> D2 transformer (scripts/ir_to_d2.py) emits this block verbatim at
# the top of every generated .d2 file, then applies the classes via `class:`.
# Encoding shape/line semantics as classes is what makes the reserved
# vocabulary CONSISTENT across all views and un-driftable (diagramskill.md
# "Enforced consistency"). Do not restyle nodes inline; add or edit a class
# here so every view moves together.
#
# Palette values are the exact hex from the Silicon Sandwiches designer brief
# (.arch/components/silicon-sandwiches/designer-agent-prompt.md, "Visual
# system"). Every colour is paired with a SHAPE and/or TEXT difference so the
# set survives grayscale (rule: colour is never the only channel).

classes: {
  # Stadium / pill = person (actor). High border-radius makes the pill.
  actor: {
    style: {
      border-radius: 999
      fill: "#d0e7f9"
      stroke: "#1a5276"
      font-color: "#111111"
    }
  }

  # Plain rectangle = system / container / component. The system box is the
  # heaviest element on a Context canvas: 2px stroke.
  system: {
    style: {
      fill: "#fdf2d0"
      stroke: "#7d6608"
      stroke-width: 2
      font-color: "#111111"
    }
  }

  # Plain rectangle for containers / components (lighter than the system box).
  container: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      font-color: "#111111"
    }
  }

  # Double-bordered rectangle = external system. Label is prefixed `EXT:` by
  # the transformer so the convention reads even in grayscale.
  external: {
    style: {
      fill: "#eeeeee"
      stroke: "#555555"
      double-border: true
      font-color: "#111111"
    }
  }

  # Orange "evidence gap" family for unresolved production evidence
  # (provisional vendor, pending contract). Still a rectangle/EXT shape; the
  # orange only reinforces a tag that is also written in the label text.
  evidence-gap: {
    style: {
      fill: "#fdebd0"
      stroke: "#b9770e"
      double-border: true
      font-color: "#111111"
    }
  }

  # Cylinder = datastore ONLY. Never use a cylinder for anything else.
  datastore: {
    shape: cylinder
    style: {
      fill: "#e8daef"
      stroke: "#6c3483"
      font-color: "#111111"
    }
  }

  # Infrastructure (e.g. load balancer) — white rectangle, dark stroke.
  infra: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      font-color: "#111111"
    }
  }

  # Faded / location-only element: reappears in a deeper view for context, not
  # as subject. De-emphasised fill + muted text.
  faded: {
    style: {
      fill: "#f8f9f9"
      stroke: "#aaaaaa"
      font-color: "#555555"
    }
  }

  # Dashed-outline container = a boundary/grouping, never a node.
  boundary: {
    style: {
      stroke-dash: 4
      fill: transparent
      font-color: "#111111"
    }
  }

  # --- Readability additions (see references/readability.md) ---

  # Dash-bordered rectangle = a runtime PROCESS, not a deployable artifact.
  # The dash border (a shape channel) carries the meaning, so it survives gray.
  process: {
    style: {
      stroke-dash: 3
      fill: "#fdebd0"
      stroke: "#b9770e"
      font-color: "#111111"
    }
  }

  # Hexagon = an element deliberately NOT modelled as a component (e.g. a
  # library an ADR records is not a component). The distinct shape says "this
  # is not one of the boxes" without a word.
  not-a-component: {
    shape: hexagon
    style: {
      fill: "#fdebd0"
      stroke: "#b9770e"
      font-color: "#111111"
    }
  }

  # Module / domain fills — LOCK these and apply the SAME one to a module in
  # EVERY view that contains it, so a reader tracks the module across the zoom
  # chain by colour (readability.md §7). Each is paired with the module name in
  # the label, so the tracking survives grayscale.
  module-a: { style: { fill: "#fef9e7"; stroke: "#7d6608"; font-color: "#111111" } }
  module-b: { style: { fill: "#eafaf1"; stroke: "#1e8449"; font-color: "#111111" } }
  module-c: { style: { fill: "#ebf5fb"; stroke: "#21618c"; font-color: "#111111" } }
  # module-d = Payments (rose) — Silicon Sandwiches 4th domain; locked for
  # colour-tracking across Container/Component views (designer brief palette).
  module-d: { style: { fill: "#fdedec"; stroke: "#943126"; font-color: "#111111" } }
}

INGEST_TEST_SOURCES: "[1] Ingest Test Sources\n[Component]" { class: module-a }
INTERPRET_TEST_INTENT: "[2] Interpret Test Intent\n[Component]" { class: module-a }
ACQUIRE_UI_EVIDENCE: "[3] Acquire UI Evidence\n[Component]" { class: module-a }
RESOLVE_ELEMENTS: "[4] Resolve Elements\n[Component]" { class: module-a }
GENERATE_TEST_CODE: "[5] Generate Test Code\n[Component]" { class: module-a }
REPAIR_LOCATORS: "[6] Repair Locators\n[Component]" { class: module-a }
INVOKE_MODELS: "[7] Invoke Models\n[Component]" { class: module-a }
VERIFY_STATICALLY: "[8] Verify Statically\n[Component]" { class: module-b }
REPLAY_ON_DEVICES: "[9] Replay on Devices\n[Component]" { class: module-b }
CLASSIFY_REPLAY_OUTCOME: "[10] Classify Replay Outcome\n[Component]" { class: module-b }
CERTIFY_CONVERSION: "[11] Certify Conversion\n[Component]" { class: module-b }
PUBLISH_CERTIFIED_ASSETS: "[12] Publish Certified Assets\n[Component]" { class: module-b }
ROUTE_HUMAN_DECISIONS: "[13] Route Human Decisions\n[Component]" { class: module-a }
PRESERVE_PROVENANCE: "[14] Preserve Provenance\n[Component]" { class: module-c }
POSTGRESQL: "[15] PostgreSQL" { class: datastore }
OBJECT_STORAGE: "[16] object storage" { class: datastore }

INGEST_TEST_SOURCES -> PRESERVE_PROVENANCE
INTERPRET_TEST_INTENT -> PRESERVE_PROVENANCE
ACQUIRE_UI_EVIDENCE -> PRESERVE_PROVENANCE
RESOLVE_ELEMENTS -> PRESERVE_PROVENANCE
GENERATE_TEST_CODE -> PRESERVE_PROVENANCE
REPAIR_LOCATORS -> PRESERVE_PROVENANCE
INVOKE_MODELS -> PRESERVE_PROVENANCE
VERIFY_STATICALLY -> PRESERVE_PROVENANCE
REPLAY_ON_DEVICES -> PRESERVE_PROVENANCE
CLASSIFY_REPLAY_OUTCOME -> PRESERVE_PROVENANCE
CERTIFY_CONVERSION -> PRESERVE_PROVENANCE
PUBLISH_CERTIFIED_ASSETS -> PRESERVE_PROVENANCE
ROUTE_HUMAN_DECISIONS -> PRESERVE_PROVENANCE
PRESERVE_PROVENANCE -> POSTGRESQL: "append-only chained writes (ADR 0012)"
PRESERVE_PROVENANCE -> OBJECT_STORAGE: "chain-head anchors at interval; a stale anchor is an alert (ADR 0012)"
