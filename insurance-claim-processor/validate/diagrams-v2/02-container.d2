ISTEP -> S3: "5"
ISTEP -> CAT: "6"
ISTEP -> GDQ: "7" { style.stroke-dash: 3 }
GDQ -> S3: "8"
ISTEP -> CMP: "9"
ISTEP -> TXT: "10"
ISTEP -> TRS: "11" { style.stroke-dash: 3 }
TRS -> S3: "12" { style.stroke-dash: 3 }
ISTEP -> CFG: "13"
ISTEP -> DWF: "14" { style.stroke-dash: 3 }
DWF -> DSTEP: "15"
DSTEP -> S3: "16"
DSTEP -> BR: "17"
DSTEP -> CFG: "18"
EB -> ISTEP: "19" { style.stroke-dash: 3 }
DQO -> CLI: "20"
CLI -> S3: "21"
DQO -> CFG: "22"
OPS -> S3: "23"
ADJ -> CLI: "24"
CLI -> BR: "25"
IWF -> EB: "26" { style.stroke-dash: 3 }
EB -> ISTEP: "27" { style.stroke-dash: 3 }
EB -> DLQ: "28" { style.stroke-dash: 3 }
