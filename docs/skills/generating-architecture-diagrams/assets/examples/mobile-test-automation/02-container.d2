# Mobile Test Automation LLM Pipeline - Container view (logical components)
# caption: This view opens the Mobile Test Automation LLM Pipeline system box from the Context view at logical-component grain: the sixteen components in three clusters, the shared screening library that is deliberately not a component, and the external systems they touch. Edges carry numbers; the numbered edge-detail table resolves each claim.
direction: down

# Canonical reserved-vocabulary D2 classes for C4-flavored diagrams.
#
# The IR -> D2 transformer (scripts/ir_to_d2.py) emits this block verbatim at
# the top of every generated .d2 file, then applies the classes via `class:`.
# Encoding shape/line semantics as classes is what makes the reserved
# vocabulary CONSISTENT across all views and un-driftable (diagramskill.md
# "Enforced consistency"). Do not restyle nodes inline; add or edit a class
# here so every view moves together.
#
# Palette values are the exact hex from the Silicon Sandwiches designer brief
# (.arch/components/silicon-sandwiches/designer-agent-prompt.md, "Visual
# system"). Every colour is paired with a SHAPE and/or TEXT difference so the
# set survives grayscale (rule: colour is never the only channel).

classes: {
  # Stadium / pill = person (actor). High border-radius makes the pill.
  actor: {
    style: {
      border-radius: 999
      fill: "#d0e7f9"
      stroke: "#1a5276"
      font-color: "#111111"
    }
  }

  # Plain rectangle = system / container / component. The system box is the
  # heaviest element on a Context canvas: 2px stroke.
  system: {
    style: {
      fill: "#fdf2d0"
      stroke: "#7d6608"
      stroke-width: 2
      font-color: "#111111"
    }
  }

  # Plain rectangle for containers / components (lighter than the system box).
  container: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      font-color: "#111111"
    }
  }

  # Double-bordered rectangle = external system. Label is prefixed `EXT:` by
  # the transformer so the convention reads even in grayscale.
  external: {
    style: {
      fill: "#eeeeee"
      stroke: "#555555"
      double-border: true
      font-color: "#111111"
    }
  }

  # Orange "evidence gap" family for unresolved production evidence
  # (provisional vendor, pending contract). Still a rectangle/EXT shape; the
  # orange only reinforces a tag that is also written in the label text.
  evidence-gap: {
    style: {
      fill: "#fdebd0"
      stroke: "#b9770e"
      double-border: true
      font-color: "#111111"
    }
  }

  # Cylinder = datastore ONLY. Never use a cylinder for anything else.
  datastore: {
    shape: cylinder
    style: {
      fill: "#e8daef"
      stroke: "#6c3483"
      font-color: "#111111"
    }
  }

  # Infrastructure (e.g. load balancer) — white rectangle, dark stroke.
  infra: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      font-color: "#111111"
    }
  }

  # Faded / location-only element: reappears in a deeper view for context, not
  # as subject. De-emphasised fill + muted text.
  faded: {
    style: {
      fill: "#f8f9f9"
      stroke: "#aaaaaa"
      font-color: "#555555"
    }
  }

  # Dashed-outline container = a boundary/grouping, never a node.
  boundary: {
    style: {
      stroke-dash: 4
      fill: transparent
      font-color: "#111111"
    }
  }

  # --- Readability additions (see references/readability.md) ---

  # Dash-bordered rectangle = a runtime PROCESS, not a deployable artifact.
  # The dash border (a shape channel) carries the meaning, so it survives gray.
  process: {
    style: {
      stroke-dash: 3
      fill: "#fdebd0"
      stroke: "#b9770e"
      font-color: "#111111"
    }
  }

  # Hexagon = an element deliberately NOT modelled as a component (e.g. a
  # library an ADR records is not a component). The distinct shape says "this
  # is not one of the boxes" without a word.
  not-a-component: {
    shape: hexagon
    style: {
      fill: "#fdebd0"
      stroke: "#b9770e"
      font-color: "#111111"
    }
  }

  # Module / domain fills — LOCK these and apply the SAME one to a module in
  # EVERY view that contains it, so a reader tracks the module across the zoom
  # chain by colour (readability.md §7). Each is paired with the module name in
  # the label, so the tracking survives grayscale.
  module-a: { style: { fill: "#fef9e7"; stroke: "#7d6608"; font-color: "#111111" } }
  module-b: { style: { fill: "#eafaf1"; stroke: "#1e8449"; font-color: "#111111" } }
  module-c: { style: { fill: "#ebf5fb"; stroke: "#21618c"; font-color: "#111111" } }
}

CC: "[1] Coordinate Conversion\nCluster A" { class: container }
ITS: "[2] Ingest Test Sources\nCluster A" { class: container }
ITI: "[3] Interpret Test Intent\nCluster A" { class: container }
AUE: "[4] Acquire UI Evidence\nCluster A" { class: container }
RE: "[5] Resolve Elements\nCluster A" { class: container }
RCA: "[6] Retrieve Conversion Assets\nCluster A" { class: container }
GTC: "[7] Generate Test Code\nCluster A" { class: container }
RL: "[8] Repair Locators\nCluster A" { class: container }
IM: "[9] Invoke Models\nCluster A" { class: container }
RHD: "[10] Route Human Decisions\nCluster A" { class: container }
VS: "[11] Verify Statically\nCluster B" { class: container }
ROD: "[12] Replay on Devices\nCluster B" { class: container }
CRO: "[13] Classify Replay Outcome\nCluster B" { class: container }
CV: "[14] Certify Conversion\nCluster B (model-bearing since pass 3)" { class: container }
PCA: "[15] Publish Certified Assets\nCluster B" { class: container }
PP: "[16] Preserve Provenance\nCluster C" { class: container }
LIB: "[17] screening library\nnot a component" { class: not-a-component }
SRC: "[18] EXT: Octane / ALM-QC / Excel" { class: external }
PERF: "[19] EXT: Perfecto device lab" { class: external }
GATEWAY: "[20] EXT: Orchestrator AI gateway" { class: external }
OBJREPO: "[21] EXT: object repository" { class: external }
GITCORP: "[22] EXT: Git prompt and exemplar corpus" { class: external }
HUMAN_EXT: "[23] EXT: QA engineers and reviewers" { class: external }

