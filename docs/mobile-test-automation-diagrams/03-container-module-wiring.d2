EVIDENCE -> OBJECT_STORAGE: "11"
CONVERSION -> SECRETS_STORE: "12"
VALIDATION_CERTIFICATION -> SECRETS_STORE: "13"
CONVERSION -> GIT: "14"
VALIDATION_CERTIFICATION -> GIT: "15"
