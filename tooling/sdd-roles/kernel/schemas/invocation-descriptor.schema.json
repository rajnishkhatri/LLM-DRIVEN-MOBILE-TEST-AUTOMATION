{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-roles:invocation-descriptor:1.4.0",
  "title": "InvocationDescriptorSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "declares", "rows"],
  "properties": {
    "schema_version": { "const": "1.4.0" },
    "artifact_type": { "const": "invocation_descriptor_set" },
    "declares": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "command_template",
        "agent_selection",
        "auth_env_var",
        "resume_semantics",
        "output_parse_mode",
        "exit_code_map"
      ],
      "properties": {
        "harness": { "type": "string", "minLength": 1 },
        "command_template": { "type": "string", "minLength": 1 },
        "agent_selection": { "type": "string", "minLength": 1 },
        "auth_env_var": { "type": "string", "minLength": 1 },
        "resume_semantics": { "type": "string", "minLength": 1 },
        "output_parse_mode": { "type": "string", "minLength": 1 },
        "hooks": { "$ref": "#/$defs/hooks" },
        "projection": { "$ref": "#/$defs/projection" },
        "exit_code_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_exit", "decision_output", "wrapper_exit"],
            "properties": {
              "tool_exit": { "type": "integer", "minimum": 0 },
              "decision_output": { "type": "string", "minLength": 1 },
              "wrapper_exit": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection_target" }
        }
      }
    },
    "projection_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path_template", "format", "char_cap", "args_token"],
      "properties": {
        "kind": {
          "enum": ["manifest", "agent-card", "skill-card", "kernel-skill", "mount-copy"]
        },
        "path_template": { "type": "string", "minLength": 1 },
        "format": { "enum": ["json", "markdown"] },
        "front_matter": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "source"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "source": { "enum": ["id", "description", "stamp"] }
            }
          }
        },
        "char_cap": { "type": ["integer", "null"], "minimum": 1 },
        "args_token": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "mount_path", "command_template", "request"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mount_path": { "type": "string", "minLength": 1 },
        "command_template": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths_pointers", "operation"],
          "properties": {
            "paths_pointers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer", "map", "default"],
              "properties": {
                "pointer": { "type": "string", "minLength": 1 },
                "map": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["from", "to"],
                    "properties": {
                      "from": { "type": "string", "minLength": 1 },
                      "to": { "enum": ["create", "modify", "delete"] }
                    }
                  }
                },
                "default": { "enum": ["create", "modify", "delete"] }
              }
            }
          }
        }
      }
    }
  }
}
